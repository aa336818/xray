#!/bin/bash

# 检查 root 权限
if [ "$EUID" -ne 0 ]; then
    echo "❌ 请使用 root 权限运行此脚本！"
    exit 1
fi

# 安装基础依赖
install_dependencies() {
    echo "🌐 正在更新软件包并安装必要依赖..."
    if command -v apt-get &>/dev/null; then
        apt-get update -y && apt-get install -y curl wget jq openssl tar
    elif command -v yum &>/dev/null; then
        yum update -y && yum install -y curl wget jq openssl tar
    fi
}

# 安装/更新 Xray 官方核心
install_xray() {
    echo "🚀 正在安装/更新 Xray 核心..."
    bash <(curl -L https://github.com/XTLS/Xray-install/raw/main/install-release.sh)
}

# 获取本机公网 IP
get_public_ip() {
    PUB_IP=$(curl -s https://api.ipify.org || curl -s https://ipv4.icanhazip.com)
}

# 模式 1：安装 Xray (XHTTP) + Cloudflare Argo Tunnel
install_xhttp_argo() {
    install_dependencies
    install_xray
    
    echo ""
    echo "=========================================="
    echo "   配置 Mode 1: Xray (XHTTP) + Argo Tunnel"
    echo "=========================================="
    
    # 参数设置
    UUID=$(/usr/local/bin/xray uuid)
    XHTTP_PATH="/xhttp-$(openssl rand -hex 4)"
    LOCAL_PORT=8080

    read -p "请输入你的 Argo 域名或 Token (留空将启动临时 Quick Tunnel 隧道): " ARGO_INPUT

    # 1. 配置 Xray
    cat <<EOF > /usr/local/etc/xray/config.json
{
  "log": { "loglevel": "warning" },
  "inbounds": [
    {
      "listen": "127.0.0.1",
      "port": $LOCAL_PORT,
      "protocol": "vless",
      "settings": {
        "clients": [{ "id": "$UUID" }],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "xhttp",
        "xhttpSettings": {
          "path": "$XHTTP_PATH"
        }
      }
    }
  ],
  "outbounds": [{ "protocol": "freedom" }]
}
EOF

    systemctl restart xray
    systemctl enable xray

    # 2. 安装并配置 cloudflared
    echo "📦 正在下载并安装 Cloudflare Tunnel (cloudflared)..."
    ARCH=$(uname -m)
    case "$ARCH" in
        x86_64) CF_ARCH="amd64" ;;
        aarch64) CF_ARCH="arm64" ;;
        *) echo "❌ 不支持的架构: $ARCH"; exit 1 ;;
    esac
    
    curl -L -o /usr/local/bin/cloudflared "https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-${CF_ARCH}"
    chmod +x /usr/local/bin/cloudflared

    # 停止旧服务
    systemctl stop cloudflared &>/dev/null
    cloudflared service uninstall &>/dev/null

    if [ -n "$ARGO_INPUT" ]; then
        if [[ "$ARGO_INPUT" == eyJ* ]]; then
            # 使用 Token 运行
            cloudflared service install "$ARGO_INPUT"
            systemctl start cloudflared
            systemctl enable cloudflared
            DOMAIN="你绑定的固定 Argo 域名"
        else
            # 用户填入了自定义域名标识，提示配合优选使用
            DOMAIN="$ARGO_INPUT"
        fi
    else
        echo "⚡ 未输入 Token，启动 Argo Quick Tunnel 快速隧道..."
        nohup cloudflared tunnel --url http://127.0.0.1:$LOCAL_PORT > /tmp/argo.log 2>&1 &
        sleep 5
        DOMAIN=$(grep -oE 'https://[a-zA-Z0-9-]+\.trycloudflare\.com' /tmp/argo.log | head -n 1 | sed 's/https:\/\///')
    fi

    # 打印节点信息
    echo ""
    echo "==== ✅ Xray (XHTTP) + Argo 部署完成 ===="
    echo "UUID        : $UUID"
    echo "XHTTP Path  : $XHTTP_PATH"
    echo "Argo 域名   : ${DOMAIN:-'请配合你的 Cloudflare SaaS/优选域名使用'}"
    echo "------------------------------------------"
    echo "📋 VLESS 节点链接 (可粘贴至 v2rayN / Shadowrocket):"
    
    NODE_DOMAIN="${DOMAIN:-saas.sin.fan}"
    VLESS_LINK="vless://${UUID}@${NODE_DOMAIN}:443?security=tls&encryption=none&type=xhttp&path=${XHTTP_PATH}&host=${NODE_DOMAIN}&sni=${NODE_DOMAIN}#Argo-XHTTP-Node"
    echo "$VLESS_LINK"
    echo "=========================================="
}

# 模式 2：安装 Xray + VLESS-REALITY 直连
install_reality() {
    install_dependencies
    install_xray
    get_public_ip

    echo ""
    echo "=========================================="
    echo "   配置 Mode 2: Xray + VLESS-REALITY 直连"
    echo "=========================================="

    # 输入 SNI 域名，默认 www.microsoft.com
    read -p "请输入 REALITY 伪装域名 SNI (默认: www.microsoft.com): " CUSTOM_SNI
    SNI=${CUSTOM_SNI:-"www.microsoft.com"}

    read -p "请输入监听端口 (默认: 443): " CUSTOM_PORT
    PORT=${CUSTOM_PORT:-443}

    # 生成密钥与参数
    UUID=$(/usr/local/bin/xray uuid)
    KEYPAIR=$(/usr/local/bin/xray x25519)
    PRIV_KEY=$(echo "$KEYPAIR" | grep "Private key" | awk '{print $3}')
    PUB_KEY=$(echo "$KEYPAIR" | grep "Public key" | awk '{print $3}')
    SHORT_ID=$(openssl rand -hex 4)

    # 配置 Xray
    cat <<EOF > /usr/local/etc/xray/config.json
{
  "log": { "loglevel": "warning" },
  "inbounds": [
    {
      "port": $PORT,
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "$UUID",
            "flow": "xtls-rprx-vision"
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "dest": "$SNI:443",
          "xver": 0,
          "serverNames": ["$SNI"],
          "privateKey": "$PRIV_KEY",
          "shortIds": ["$SHORT_ID"]
        }
      }
    }
  ],
  "outbounds": [{ "protocol": "freedom" }]
}
EOF

    systemctl restart xray
    systemctl enable xray

    # 打印节点信息
    echo ""
    echo "==== ✅ Xray VLESS-REALITY 部署完成 ===="
    echo "服务器 IP   : $PUB_IP"
    echo "端口        : $PORT"
    echo "UUID        : $UUID"
    echo "SNI / 域名  : $SNI"
    echo "Public Key  : $PUB_KEY"
    echo "Short ID    : $SHORT_ID"
    echo "------------------------------------------"
    echo "📋 REALITY 节点链接 (可粘贴至 v2rayN / Shadowrocket):"
    
    REALITY_LINK="vless://${UUID}@${PUB_IP}:${PORT}?security=reality&encryption=none&pbk=${PUB_KEY}&headerType=none&type=tcp&flow=xtls-rprx-vision&sni=${SNI}&sid=${SHORT_ID}#REALITY-${SNI}"
    echo "$REALITY_LINK"
    echo "=========================================="
}

# 菜单选择
clear
echo "=========================================="
echo "      Xray 一键集成部署脚本"
echo "=========================================="
echo " 1. 安装 Xray (XHTTP) + Cloudflare Argo 隧道"
echo " 2. 安装 Xray + VLESS-REALITY (原生直连，支持自定义/微软域名)"
echo " 0. 退出"
echo "=========================================="
read -p "请输入选项 [0-2]: " CHOICE

case "$CHOICE" in
    1)
        install_xhttp_argo
        ;;
    2)
        install_reality
        ;;
    0)
        exit 0
        ;;
    *)
        echo "❌ 无效的选项！"
        exit 1
        ;;
esac
